# ========================================
# PythonWebApp - Environment Configuration
# ========================================
# Copy this file to .env and fill in your values
# DO NOT commit the .env file to version control!

# ========================================
#     ONLY FOR DEVELOPMENT PURPOSES 
# ========================================
# Security
# ========================================
# Generate a secret key using: openssl rand -base64 32
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_base64_32

# ========================================
# Admin Account
# ========================================
# Default admin user created on first startup
ADMIN_MAIL=admin@example.com
ADMIN_PASSWORD=SecurePassword123!

# ========================================
#       FOR PRODUCTION DEPLOYMENT
# ========================================
# Application URLs
# ========================================
# Backend API URL (used by frontend)
REACT_APP_BACKEND_URL=http://localhost:5000/api

# Frontend URL (used by backend for CORS)
FRONTEND_URL=http://localhost:80

# ========================================
# Database Configuration
# ========================================
# Individual database credentials (used by docker-compose)
POSTGRES_DB=users_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# PostgreSQL Database Connection String (constructed automatically if not set)
# Format: postgresql://username:password@host:port/database
# Leave commented to use auto-constructed URL from individual credentials above
# DATABASE_URL=postgresql://postgres_user:your_secure_password@db:5432/users_db

# ========================================
# Flask Environment
# ========================================
# Options: development, production
FLASK_ENV=development

# ========================================
# Branding Configuration (Optional)
# ========================================
# Backend Branding
APP_NAME=PythonWebApp
# APP_SHORT_NAME=PWA
# COMPANY_NAME=Your Company
# COMPANY_URL=https://example.com
# API_TITLE=PythonWebApp API
# API_DESCRIPTION=API Documentation for PythonWebApp
# CONTACT_EMAIL=contact@example.com

# Frontend Branding
REACT_APP_NAME=PythonWebApp
# REACT_APP_SHORT_NAME=PWA
# REACT_APP_COMPANY_NAME=Your Company
# REACT_APP_COMPANY_URL=https://example.com
# REACT_APP_DESCRIPTION=Application moderne de gestion d'utilisateurs
# REACT_APP_TAGLINE=Bienvenue sur PythonWebApp
# REACT_APP_CONTACT_EMAIL=contact@example.com
# REACT_APP_COPYRIGHT_HOLDER=Your Company

# ========================================
# Email Configuration (Required for password reset & email verification)
# ========================================

# OPTION 1: Gmail (Recommended for testing)
# -----------------------------------------
# 1. Go to: https://myaccount.google.com/apppasswords
# 2. Sign in to your Google account
# 3. Click "Select app" → Choose "Mail"
# 4. Click "Select device" → Choose "Other" → Type "PythonWebApp"
# 5. Click "Generate"
# 6. Copy the 16-character password (spaces don't matter)
# 7. Use these settings:
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=abcd efgh ijkl mnop
MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# OPTION 2: Outlook/Hotmail
# -----------------------------------------
# MAIL_SERVER=smtp-mail.outlook.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USE_SSL=False
# MAIL_USERNAME=your-email@outlook.com
# MAIL_PASSWORD=your-regular-password
# MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# OPTION 3: Office 365
# -----------------------------------------
# MAIL_SERVER=smtp.office365.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USE_SSL=False
# MAIL_USERNAME=your-email@yourcompany.com
# MAIL_PASSWORD=your-regular-password
# MAIL_DEFAULT_SENDER=noreply@yourcompany.com

# OPTION 4: SendGrid (Production recommended)
# -----------------------------------------
# 1. Sign up at https://sendgrid.com
# 2. Create API Key: Settings → API Keys → Create API Key
# 3. Use these settings:
# MAIL_SERVER=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USE_SSL=False
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=SG.your-sendgrid-api-key-here
# MAIL_DEFAULT_SENDER=noreply@yourdomain.com

# OPTION 5: Mailtrap (Testing only - emails won't be sent to real addresses)
# -----------------------------------------
# 1. Sign up at https://mailtrap.io
# 2. Go to Inboxes → Your Inbox → SMTP Settings
# 3. Use these settings:
# MAIL_SERVER=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USE_TLS=True
# MAIL_USE_SSL=False
# MAIL_USERNAME=your-mailtrap-username
# MAIL_PASSWORD=your-mailtrap-password
# MAIL_DEFAULT_SENDER=noreply@test.com

# NOTES:
# - MAIL_DEFAULT_SENDER: The "From" address shown in emails (can be different from MAIL_USERNAME)
# - For production: Use SendGrid, AWS SES, or Mailgun for better deliverability
# - For testing: Use Mailtrap to catch emails without sending them
# - Gmail App Password: Required if you have 2-Step Verification enabled
